# Binaries (anchored to repo root so they don't shadow internal/qw, cmd/qwproxy)
/bin/
/dist/
/qw
/qwproxy
*.exe

# Test / coverage
*.out
coverage.*

# Local env / secrets — never commit
*.env
.env
.env.*
!.env.example

# Local qw config files (hold cached OIDC tokens) — never commit
/test.yaml
/*.local.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local data volumes from docker-compose
deploy/compose/.data/

.sessions/
.claude/
