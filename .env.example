# ─────────────────────────── qwproxy configuration ───────────────────────────
# The proxy reads these from the environment (12-factor). The local simulation
# stack (deploy/compose) sets them for you; this file documents every knob.

# Address qwproxy listens on.
QWPROXY_LISTEN_ADDR=:9000

# Upstream Quickwit REST API. In-cluster this is the searcher Service DNS.
QWPROXY_UPSTREAM=http://quickwit:7280

# OIDC issuer whose JWTs the proxy will accept. Locally this is Keycloak;
# in prod it is your Okta org URL. The proxy fetches <issuer>/.well-known/openid-configuration.
QWPROXY_OIDC_ISSUER=http://localhost:8080/realms/quickwit

# This deployment's OIDC client id, enforced as the token `aud`. The CLI presents
# its ID token, whose aud is the client id (unique per app/env), so a token minted
# for another environment is rejected — e.g. a stage token dies at the prod proxy.
# The proxy REFUSES TO START unless one of the three audience knobs below is set.
QWPROXY_OIDC_CLIENT_ID=qw-cli

# Optional: additional accepted client ids (comma-separated), so one proxy fronts
# several callers at once — e.g. the qw CLI plus a Grafana service identity. A
# token is accepted when its aud matches CLIENT_ID or any of these.
# QWPROXY_OIDC_CLIENT_IDS=qw-cli,grafana

# Legacy alias: an API audience stamped on access tokens by a custom authorization
# server. Prefer QWPROXY_OIDC_CLIENT_ID above; client id wins if both are set.
# QWPROXY_OIDC_AUDIENCE=quickwit-api

# Dev-only escape hatch: accept ANY token the issuer signs (no aud check). Never
# set this in production — it re-opens the "any org token passes" hole.
# QWPROXY_INSECURE_SKIP_AUDIENCE=false

# Postgres DSN for the audit store. Response bodies are NEVER written here.
QWPROXY_AUDIT_DSN=postgres://qwaudit:qwaudit@postgres:5432/qwaudit?sslmode=disable

# Async audit writer tuning.
QWPROXY_AUDIT_BUFFER=4096          # bounded channel size; overflow is dropped + counted
QWPROXY_AUDIT_BATCH=100            # rows per batched INSERT
QWPROXY_AUDIT_FLUSH_MS=1000        # max time a partial batch waits before flushing

# Audit-store Postgres connection pool. The audit writer is a single goroutine
# issuing serial batched inserts, so a small pool is plenty. Capping it keeps
# qwproxy — especially across replicas — from exhausting Postgres max_connections.
QWPROXY_AUDIT_MAX_CONNS=4                  # hard cap on open connections per proxy
QWPROXY_AUDIT_MIN_CONNS=0                  # warm idle connections to keep (0 = none)
QWPROXY_AUDIT_CONN_MAX_LIFETIME_MS=3600000 # recycle a connection after this age (1h)
QWPROXY_AUDIT_CONN_MAX_IDLE_MS=300000      # close a connection idle this long (5m)
QWPROXY_AUDIT_HEALTHCHECK_MS=60000         # how often the pool prunes/checks conns (1m)

# ─────────────────────── qw CLI (non-interactive / CI) ───────────────────────
# The CLI normally uses a saved context + `qw login`. For CI/cron, set these
# instead of logging in — with QW_ENDPOINT + a credential you need no config file.
# QW_ENDPOINT=https://qwproxy.internal   # overrides the context endpoint
# QW_TOKEN=eyJhbGci...                   # static bearer token (skips OIDC)
# QW_CLIENT_SECRET=...                   # OIDC client-credentials secret (mint+refresh)
# QW_ISSUER=https://acme.okta.com        # for the no-config client-credentials path
# QW_CLIENT_ID=qw-ci
# QW_AUDIENCE=quickwit-api
# QW_CONTEXT=prod                        # select a saved context (like kubectl)
# QW_BEARER_TOKEN=id-token               # which token to send: id-token (default;
#                                        # aud = client id, what qwproxy verifies)
#                                        # or access-token (custom auth server only)
